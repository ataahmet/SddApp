#!/usr/bin/env bash
# sdd-release — package the SDD kit that install.sh puts into a project.
#
#   scripts/sdd-release [--version vX.Y.Z] [--out DIR]   → DIR/sdd.tar.gz (+ .sha256, + sdd-vX.Y.Z.tar.gz)
#   scripts/sdd-release [--version REF]   --stage DIR    → the same layout, unpacked, in DIR
#
# The release workflow (.github/workflows/release.yml) runs the first form on
# every v* tag and attaches the files to the GitHub release; install.sh
# downloads them. install.sh runs the second form when it installs straight
# from a branch (--version main), so both paths produce the same layout:
#
#   sdd/
#     VERSION          the kit version, written to <project>/scripts/lib/VERSION
#     manifest.txt     the paths install.sh copies into the project
#     gitignore.sdd    the rules it appends to the project's .gitignore
#     payload/…        the files themselves (SDD-README.md = artifact/sdd-usage.md)
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
version=""
out=""
stage=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --version) version="${2:?--version needs a value}"; shift 2 ;;
    --out)     out="${2:?--out needs a directory}"; shift 2 ;;
    --stage)   stage="${2:?--stage needs a directory}"; shift 2 ;;
    -h|--help) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "Unknown argument: $1" >&2; exit 2 ;;
  esac
done

if [ -z "$version" ]; then
  version="$(git -C "$ROOT" describe --tags --always --dirty 2>/dev/null || echo dev)"
fi

assemble() { # <dest>
  local dest="$1" path source
  mkdir -p "$dest/payload"
  printf '%s\n' "$version" > "$dest/VERSION"
  cp "$ROOT/artifact/manifest.txt" "$dest/manifest.txt"
  cp "$ROOT/artifact/gitignore.sdd" "$dest/gitignore.sdd"
  while IFS= read -r path || [ -n "$path" ]; do
    case "$path" in ""|\#*) continue ;; esac
    path="${path%/}"
    if [ "$path" = "SDD-README.md" ]; then
      source="$ROOT/artifact/sdd-usage.md"
    else
      source="$ROOT/$path"
    fi
    [ -e "$source" ] || { echo "Missing kit file: $path" >&2; exit 1; }
    mkdir -p "$(dirname "$dest/payload/$path")"
    cp -pR "$source" "$dest/payload/$path"
  done < "$ROOT/artifact/manifest.txt"
  chmod +x "$dest/payload/scripts/sdd"
}

if [ -n "$stage" ]; then
  assemble "$stage"
  echo "Staged sdd $version in $stage"
  exit 0
fi

out="${out:-$ROOT/dist}"
mkdir -p "$out"
out="$(cd "$out" && pwd)"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

assemble "$work/sdd"
# COPYFILE_DISABLE: keep macOS tar from adding ._* AppleDouble files.
( cd "$work" && COPYFILE_DISABLE=1 tar -czf "$out/sdd.tar.gz" sdd )
cp "$out/sdd.tar.gz" "$out/sdd-$version.tar.gz"

sha() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi \
    | awk '{print $1}'
}
for f in sdd.tar.gz "sdd-$version.tar.gz"; do
  printf '%s  %s\n' "$(sha "$out/$f")" "$f" > "$out/$f.sha256"
done

echo "Built sdd $version:"
echo "  $out/sdd.tar.gz            (stable name — install.sh downloads releases/latest/download/sdd.tar.gz)"
echo "  $out/sdd-$version.tar.gz   (versioned — for pinned installs)"
