#!/usr/bin/env bash
# sdd-release — version and package the SDD kit that install.sh puts into a project.
#
#   scripts/sdd-release bump <patch|minor|major|X.Y.Z>   → VERSION updated, committed, tagged vX.Y.Z
#   scripts/sdd-release [--version X.Y.Z] [--out DIR]   → DIR/sdd.tar.gz, sdd.tar.gz.sha256, install.sh
#   scripts/sdd-release [--version X.Y.Z] --stage DIR   → the same layout, unpacked, in DIR
#
# VERSION (repository root) is the single source of the version number. Without
# --version the build is stamped VERSION when HEAD is the tag vVERSION, and
# VERSION-dev+<commit> otherwise, so an unreleased build never passes for one.
#
# The release workflow (.github/workflows/release.yml) runs the --out form on
# every v* tag and attaches the files to the GitHub release; install.sh
# downloads the archive, and `sdd self-update` takes install.sh from the same
# release. install.sh runs the --stage form when it installs straight
# from a branch (--version main), so both paths produce the same layout:
#
#   sdd/
#     VERSION          the kit version, written to <project>/scripts/lib/VERSION
#     manifest.txt     the paths install.sh copies into the project
#     gitignore.sdd    the rules it appends to the project's .gitignore
#     payload/…        the files themselves (SDD-README.md = kit/sdd-usage.md,
#                      CLAUDE.md = kit/claude-template.md)
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
version=""
out=""
stage=""

die() { echo "✗ $*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Usage:
  scripts/sdd-release bump <patch|minor|major|X.Y.Z>   update VERSION, commit, tag vX.Y.Z
  scripts/sdd-release [--version X.Y.Z] [--out DIR]   build DIR/sdd.tar.gz (+ .sha256) and copy install.sh
  scripts/sdd-release [--version X.Y.Z] --stage DIR   the same kit, unpacked, in DIR

Without --version a build is stamped VERSION on its clean tag, VERSION-dev+<commit> otherwise.
DIR defaults to dist/. Publishing: git push origin HEAD vX.Y.Z (the release workflow builds it).
EOF
}

read_version_file() {
  local v
  [ -f "$ROOT/VERSION" ] || die "No VERSION file in $ROOT."
  v="$(tr -d '[:space:]' < "$ROOT/VERSION")"
  case "$v" in
    [0-9]*.[0-9]*.[0-9]*) ;;
    *) die "VERSION must be X.Y.Z, found '$v'." ;;
  esac
  echo "$v"
}

# VERSION, or VERSION-dev+<commit>[.dirty] when HEAD is not exactly that release.
build_version() {
  local base sha tag
  base="$(read_version_file)"
  tag="$(git -C "$ROOT" describe --exact-match --tags HEAD 2>/dev/null || true)"
  if [ "$tag" = "v$base" ] && git -C "$ROOT" diff --quiet HEAD 2>/dev/null; then
    echo "$base"
    return
  fi
  sha="$(git -C "$ROOT" rev-parse --short=7 HEAD 2>/dev/null || echo unknown)"
  git -C "$ROOT" diff --quiet HEAD 2>/dev/null || sha="$sha.dirty"
  echo "$base-dev+$sha"
}

# bump <patch|minor|major|X.Y.Z>: writes VERSION, commits it and tags vX.Y.Z.
# Pushing is left to you: the tag is what publishes.
bump() {
  local how="${1:-}" cur major minor patch next
  cur="$(read_version_file)"
  major="${cur%%.*}"; minor="${cur#*.}"; minor="${minor%%.*}"; patch="${cur##*.}"
  case "$how" in
    patch) next="$major.$minor.$((patch + 1))" ;;
    minor) next="$major.$((minor + 1)).0" ;;
    major) next="$((major + 1)).0.0" ;;
    [0-9]*.[0-9]*.[0-9]*) next="${how#v}" ;;
    v[0-9]*.[0-9]*.[0-9]*) next="${how#v}" ;;
    *) die "Usage: scripts/sdd-release bump <patch|minor|major|X.Y.Z>   (VERSION is $cur)" ;;
  esac
  git -C "$ROOT" diff --quiet HEAD && [ -z "$(git -C "$ROOT" status --porcelain)" ] \
    || die "Commit or stash your changes first — the release commit should contain only VERSION."
  git -C "$ROOT" rev-parse -q --verify "refs/tags/v$next" >/dev/null \
    && die "Tag v$next already exists."

  printf '%s\n' "$next" > "$ROOT/VERSION"
  git -C "$ROOT" add VERSION
  git -C "$ROOT" commit -q -m "Release v$next"
  git -C "$ROOT" tag -a "v$next" -m "sdd $next"
  echo "✓ VERSION $cur → $next, committed and tagged v$next."
  echo "  Publish it (the release workflow builds and uploads on the tag):"
  echo "    git push origin HEAD v$next"
}

if [ "${1:-}" = "bump" ]; then
  shift
  bump "$@"
  exit 0
fi

while [ "$#" -gt 0 ]; do
  case "$1" in
    --version) version="${2:?--version needs a value}"; shift 2 ;;
    --out)     out="${2:?--out needs a directory}"; shift 2 ;;
    --stage)   stage="${2:?--stage needs a directory}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

if [ -z "$version" ]; then
  version="$(build_version)"
fi
version="${version#v}"

assemble() { # <dest>
  local dest="$1" path source
  mkdir -p "$dest/payload"
  printf '%s\n' "$version" > "$dest/VERSION"
  cp "$ROOT/kit/manifest.txt" "$dest/manifest.txt"
  cp "$ROOT/kit/gitignore.sdd" "$dest/gitignore.sdd"
  while IFS= read -r path || [ -n "$path" ]; do
    case "$path" in ""|\#*) continue ;; esac
    path="${path%/}"
    if [ "$path" = "SDD-README.md" ]; then
      source="$ROOT/kit/sdd-usage.md"
    elif [ "$path" = "CLAUDE.md" ]; then
      source="$ROOT/kit/claude-template.md"
    else
      source="$ROOT/$path"
    fi
    [ -e "$source" ] || { echo "Missing kit file: $path" >&2; exit 1; }
    mkdir -p "$(dirname "$dest/payload/$path")"
    cp -pR "$source" "$dest/payload/$path"
  done < "$ROOT/kit/manifest.txt"
  chmod +x "$dest/payload/scripts/sdd"
}

if [ -n "$stage" ]; then
  assemble "$stage"
  echo "Staged sdd $version in $stage"
  exit 0
fi

out="${out:-$ROOT/dist}"
mkdir -p "$out"
out="$(cd "$out" && pwd)"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

assemble "$work/sdd"
# COPYFILE_DISABLE: keep macOS tar from adding ._* AppleDouble files.
( cd "$work" && COPYFILE_DISABLE=1 tar -czf "$out/sdd.tar.gz" sdd )
cp "$ROOT/install.sh" "$out/install.sh"

sha() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi \
    | awk '{print $1}'
}
printf '%s  %s\n' "$(sha "$out/sdd.tar.gz")" sdd.tar.gz > "$out/sdd.tar.gz.sha256"

echo "Built sdd $version in $out:"
echo "  sdd.tar.gz, sdd.tar.gz.sha256   the kit (install.sh downloads releases/<tag>/download/sdd.tar.gz)"
echo "  install.sh                      the installer of this release (sdd self-update fetches it)"
