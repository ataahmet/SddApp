#!/usr/bin/env bash
# sdd — Specification-Driven Development CLI
# Flow: new → ready → align → align-resolve → critique(loop) → verify → start(branch) → implement → done
# Lifecycle: draft → ready → active → done | blocked | dropped
# Gate: verify must PASS (no open questions) before implement can run.
# Details: SDD-README.md (kit/sdd-usage.md in the kit repo)
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SPECS="$ROOT/specs"
TEMPLATES="$SPECS/templates"

# shellcheck source=lib/driver-claude.sh
source "$ROOT/scripts/lib/driver-claude.sh"
# shellcheck source=lib/driver-copilot.sh
source "$ROOT/scripts/lib/driver-copilot.sh"
# shellcheck source=lib/critique.sh
source "$ROOT/scripts/lib/critique.sh"

# Agent backend selection: claude | copilot | auto (default). `auto` resolves by
# binary presence only — copilot first, then claude (see resolve_agent_backend) —
# with no runtime fallback on auth/quota failure (D6). Pin SDD_AGENT when the
# per-role model table matters: every Copilot role currently runs on 'auto'.
# See specs/refactors/002-copilot-cli-agent-support/spec.md.
SDD_AGENT="${SDD_AGENT:-auto}"

# Branch prefix for `sdd start`: branches are <prefix>/{task_id}-{task_name}
# (SDD-README.md, "8. Open the branch"). The default is 'sdd', not 'main': git
# stores branch names as paths under refs/heads/, so 'main/001-x' can never be
# created while a branch called 'main' exists — which is nearly every repository.
SDD_BRANCH_PREFIX="${SDD_BRANCH_PREFIX:-sdd}"

# Setup guide named in error messages: 'SDD-README.md' in an installed project,
# 'kit/sdd-usage.md' in the kit repository itself (same document).
if [ -f "$ROOT/SDD-README.md" ]; then
  SETUP_GUIDE="SDD-README.md"
else
  SETUP_GUIDE="kit/sdd-usage.md"
fi

# Per-role model selection (premium quota optimisation). Each of these env vars,
# if set, overrides the role's model on WHICHEVER backend ends up resolved —
# left unset here deliberately (see model_default/model_for_role below): the
# right default depends on the backend, which isn't known until run_agent
# resolves it, so no backend-specific literal is baked in at parse time.
#   SDD_MODEL_ALIGN     — strongest  — open decision generation
#   SDD_MODEL_IMPLEMENT — medium     — code writing
#   SDD_MODEL_VERIFY    — medium     — read-only inspection
#   SDD_MODEL_CRITIQUE  — strongest  — adversarial spec review (reviewer half)
#   SDD_MODEL_REFINE    — medium     — applying review action items (executor half)
#   SDD_MODEL_KTLINT    — cheapest   — mechanical format fixing

###############################################################################
# Utility helpers
###############################################################################

# type (singular) → folder (plural)
plural() {
  case "$1" in
    feature)  echo "features" ;;
    bug)      echo "bugs" ;;
    test)     echo "tests" ;;
    refactor) echo "refactors" ;;
    *)        echo "" ;;
  esac
}

# type (singular) → commit/spec short code (same as template H1 headings)
type_code() {
  case "$1" in
    feature)  echo "FEAT" ;;
    bug)      echo "BUG" ;;
    test)     echo "TEST" ;;
    refactor) echo "REF" ;;
    *)        echo "SPEC" ;;
  esac
}

slugify() {
  echo "$1" | tr '[:upper:]' '[:lower:]' | tr ' ' '-' | tr -cd 'a-z0-9-'
}

today() { date +%Y-%m-%d; }

# Next 3-digit task_id (unique counter across all types)
next_id() {
  local max=0
  for d in "$SPECS"/{features,bugs,tests,refactors}/*/; do
    [ -d "$d" ] || continue
    n="$(basename "$d" | grep -oE "^[0-9]+" || true)"
    [ -n "$n" ] && (( 10#$n > max )) && max=$((10#$n))
  done
  printf "%03d" $((max + 1))
}

###############################################################################
# Front-matter helpers
###############################################################################

# Read front matter field
# A trailing '# comment' is not part of the value: the templates document each
# lifecycle field on its own line ('status: draft   # draft → ready → …') and
# fm_set keeps that comment when it rewrites the value. Every key read through
# here is a lifecycle field whose value never contains '#'; agent front matter
# is read by agent_fm_get instead.
fm_get() {
  grep -E "^$2:" "$1" | head -1 \
    | sed -E "s/^$2:[[:space:]]*//; s/[[:space:]]*#.*$//; s/[[:space:]]+$//"
}

# In-place sed that works with both BSD sed (macOS) and GNU sed (Linux).
# `sed -i ''` is BSD-only (GNU sed reads '' as the script) and `sed -i` is
# GNU-only (BSD sed takes the next argument as a backup suffix), so neither
# form is portable. Writing to a temp file and moving it over the original is,
# and it is the same pattern fm_upsert already uses.
sed_inplace() { # <file> <sed args...>
  local file="$1"; shift
  if sed "$@" "$file" > "$file.tmp"; then
    mv "$file.tmp" "$file"
  else
    rm -f "$file.tmp"
    return 1
  fi
}

# Write front matter field (first matching line).
# Done with awk, not sed: the value and the line's trailing '# comment' are passed
# as data, so a '|', '&' or backslash in either cannot corrupt the substitution
# (template comments like '# draft | blocked | dropped' do contain '|'). The
# comment is preserved — it is the template's own documentation — and only the
# FIRST matching line is rewritten, so prose further down the spec is untouched.
fm_set() {
  local file="$1" key="$2" val="$3"
  awk -v k="$key" -v v="$val" '
    BEGIN { done = 0 }
    !done && index($0, k ":") == 1 {
      cmt = ""
      p = index($0, "#"); if (p > 0) cmt = substr($0, p)
      line = k ": " v
      if (cmt != "") {
        while (length(line) < 25) line = line " "          # template column
        if (substr(line, length(line), 1) != " ") line = line " "
        line = line cmt
      }
      print line; done = 1; next
    }
    { print }
  ' "$file" > "$file.tmp" && mv "$file.tmp" "$file"
}

# Add/update front matter field (inserts before closing --- if not found)
fm_upsert() {
  local file="$1" key="$2" val="$3"
  if grep -qE "^$key:" "$file"; then
    fm_set "$file" "$key" "$val"
  else
    awk -v k="$key" -v v="$val" '
      BEGIN { c = 0 }
      /^---[[:space:]]*$/ { c++; if (c == 2) print k ": " v }
      { print }
    ' "$file" > "$file.tmp" && mv "$file.tmp" "$file"
  fi
}

spec_path() { # <type> <id-name>
  echo "$SPECS/$(plural "$1")/$2/spec.md"
}

###############################################################################
# Section / alignment inspection helpers
###############################################################################

# Does a section have real content? (comments / empty items / {placeholder} don't count)
# Usage: section_filled <file> <heading-regex>  → returns 0 if filled
section_filled() {
  awk -v re="$2" '
    function trim(s){ gsub(/^[[:space:]]+|[[:space:]]+$/,"",s); return s }
    BEGIN{ insec=0; found=0; incmt=0 }
    $0 ~ re { insec=1; next }
    insec && /^#{1,6}[[:space:]]/ { insec=0 }
    insec {
      line=$0
      if (incmt){ if(line ~ /-->/) incmt=0; next }
      if (line ~ /<!--/ && line !~ /-->/){ incmt=1; next }
      gsub(/<!--.*-->/,"",line)
      t=trim(line)
      if (t=="") next
      if (t ~ /^[-*][[:space:]]*$/) next                        # empty item
      if (t ~ /^[-*][[:space:]]*\[[ xX]?\][[:space:]]*$/) next  # empty checkbox
      if (t ~ /^`?\{.*\}`?$/) next                              # {placeholder}
      found=1
    }
    END{ exit(found?0:1) }
  ' "$1"
}

# Scan the Alignment section: QUEST=.. ANSW=.. EMPTY=.. and optionally MISS=..
check_alignment() {
  awk '
    function trim(s){ gsub(/^[[:space:]]+|[[:space:]]+$/,"",s); return s }
    BEGIN { insec=0; quest=0; answ=0; empty=0; lastq=""; miss=""; incmt=0 }
    /^#{1,6}[[:space:]].*Open Decisions \(Alignment\)/ { insec=1; next }
    insec && /^#{1,6}[[:space:]]/ { insec=0 }
    insec {
      line=$0
      if (incmt) { if (line ~ /-->/) incmt=0; next }
      if (line ~ /<!--/ && line !~ /-->/) { incmt=1; next }
      gsub(/<!--.*-->/, "", line)
      if (line ~ /\*\*Question:\*\*/) { quest++; q=line; sub(/.*\*\*Question:\*\*/,"",q); lastq=trim(q) }
      if (line ~ /\*\*Answer:\*\*/) {
        answ++; a=line; sub(/.*\*\*Answer:\*\*/,"",a); a=trim(a)
        if (a==""){ empty++; miss=miss (miss=="" ? ("# " answ) : lastq) }
      }
    }
    END {
      printf "QUEST=%d ANSW=%d EMPTY=%d\n", quest, answ, empty
      if (empty>0) printf "MISS=%s\n", miss
    }
  ' "$1"
}

# Are the Open Decisions answered AND formally resolved via align-resolve?
require_alignment_resolved() {
  local spec="$1"
  grep -qiE "^#{1,6}.*Open Decisions \(Alignment\)" "$spec" || return 0  # no section → gate not applied
  local out quest answ empty miss
  out="$(check_alignment "$spec")"
  quest="$(printf '%s' "$out" | sed -n 's/.*QUEST=\([0-9]*\).*/\1/p')"
  answ="$(printf '%s' "$out" | sed -n 's/.*ANSW=\([0-9]*\).*/\1/p')"
  empty="$(printf '%s' "$out" | sed -n 's/.*EMPTY=\([0-9]*\).*/\1/p')"
  miss="$(printf '%s\n' "$out" | sed -n 's/^MISS=//p')"
  if [ "${quest:-0}" -eq 0 ]; then
    echo "✗ No questions in the Alignment section. Run 'sdd align $spec' first."; return 1
  fi
  if [ "${empty:-0}" -gt 0 ] || [ "${answ:-0}" -lt "${quest:-0}" ]; then
    echo "✗ Cannot proceed until Open Decisions are answered (answered $(( answ - empty ))/$quest)."
    [ -n "$miss" ] && echo "  Missing answers: $miss"
    echo "  Fill in the answers and try again."; return 1
  fi
  # Front matter flag: must be explicitly set to 'resolved' by align-resolve.
  # Skip check if field is absent or '~' (backwards-compatible with specs that predate alignment).
  local flag
  flag="$(fm_get "$spec" alignment)"
  if [ -n "$flag" ] && [ "$flag" != "~" ] && [ "$flag" != "resolved" ]; then
    echo "✗ alignment is '$flag' — answers look filled but 'sdd align-resolve' was never run."
    echo "  Run: ./scripts/sdd align-resolve $spec"
    return 1
  fi
  return 0
}

# Mandatory gate: start/implement are blocked until the spec has passed verify (no open questions).
require_verify_passed() {
  local spec="$1" flag
  flag="$(fm_get "$spec" verify)"
  if [ "$flag" != "passed" ]; then
    echo "✗ verify is '${flag:-none}' — the spec has not passed verification."
    echo "  Run: ./scripts/sdd verify $spec  (must PASS before opening a branch / implementing)."
    return 1
  fi
  return 0
}

list_tasks() { # <spec>
  grep -oE '^[[:space:]]*-[[:space:]]*\[[ xX]?\][[:space:]]*T[0-9]+' "$1" | grep -oE 'T[0-9]+'
}

# Tasks whose checkbox is still empty: '- [ ] T3' or '- [] T3', not '- [x] T3'.
list_open_tasks() { # <spec>
  { grep -oE '^[[:space:]]*-[[:space:]]*\[ ?\][[:space:]]*T[0-9]+' "$1" || true; } | grep -oE 'T[0-9]+' || true
}

###############################################################################
# Model roles (per-driver role→model tables, §3 of spec 002)
###############################################################################

# Backend-specific default model for a role. bash 3.2 (macOS default) has no
# associative arrays, hence the case table instead of a map. The "copilot"
# branch is data only — no copilot dispatch exists yet (scripts/lib/driver-
# copilot.sh, T5); resolve_agent_backend never returns "copilot" today, so
# these entries simply sit ready for T5 to start returning it.
model_default() { # <role> <backend>
  local role="$1" backend="$2"
  case "${role}:${backend}" in
    align:claude)        echo "opus" ;;
    critique:claude)     echo "opus" ;;
    refine:claude)       echo "sonnet" ;;
    implement:claude)    echo "sonnet" ;;
    verify:claude)       echo "sonnet" ;;
    ktlint:claude)       echo "haiku" ;;
    # Copilot: every named model this plan was probed with is rejected by the
    # CLI ("Model ... is not available"), including the ones `copilot help
    # config` documents. Per-role selection therefore has no entitlement to
    # act on and all four roles resolve to "auto", which works. The
    # SDD_MODEL_* overrides still take precedence, so a named model can be
    # pinned the moment the plan exposes one; `sdd doctor` (T11) reports what
    # the installed CLI actually accepts.
    align:copilot|critique:copilot|refine:copilot|implement:copilot|verify:copilot|ktlint:copilot) echo "auto" ;;
    *)
      echo "sdd: no default model for role '$role' on backend '$backend'" >&2
      return 1
      ;;
  esac
}

# Resolves the model to use for a role on a resolved backend: the role's
# SDD_MODEL_* env var wins if set (same override names on both backends, per
# T4/§3); otherwise falls back to that backend's default from model_default.
model_for_role() { # <role> <backend>
  local role="$1" backend="$2" override=""
  case "$role" in
    align)     override="${SDD_MODEL_ALIGN:-}" ;;
    critique)  override="${SDD_MODEL_CRITIQUE:-}" ;;
    refine)    override="${SDD_MODEL_REFINE:-}" ;;
    implement) override="${SDD_MODEL_IMPLEMENT:-}" ;;
    verify)    override="${SDD_MODEL_VERIFY:-}" ;;
    ktlint)    override="${SDD_MODEL_KTLINT:-}" ;;
    *)
      echo "sdd: model_for_role: unknown role '$role'" >&2
      return 1
      ;;
  esac
  if [ -n "$override" ]; then
    echo "$override"
  else
    model_default "$role" "$backend"
  fi
}

###############################################################################
# Agent driver dispatch (backends live in scripts/lib/driver-*.sh)
###############################################################################

# Resolves SDD_AGENT (claude|copilot|auto) to a concrete backend by binary
# presence only — no runtime fallback on auth/quota failure (D6). On success,
# prints the backend name ("claude"/"copilot") on stdout. On failure, prints a
# neutral English "CLI not found" message on stderr and returns 1. It also
# fails when the user's deny list has not been applied to that backend
# (require_user_deny), so no agent ever runs without it.
resolve_agent_backend() {
  local backend
  case "$SDD_AGENT" in
    claude)
      driver_claude_available || { agent_not_found_message "claude"; return 1; }
      backend="claude"
      ;;
    copilot)
      driver_copilot_available || { agent_not_found_message "copilot"; return 1; }
      backend="copilot"
      ;;
    auto)
      if driver_copilot_available; then
        backend="copilot"
      elif driver_claude_available; then
        backend="claude"
      else
        agent_not_found_message "auto"
        return 1
      fi
      ;;
    *)
      echo "Unknown SDD_AGENT '$SDD_AGENT' (expected: claude|copilot|auto)." >&2
      return 1
      ;;
  esac
  require_user_deny "$backend" || return 1
  echo "$backend"
}

agent_not_found_message() {
  local requested="$1"
  case "$requested" in
    claude)  echo "No agent CLI found: 'claude' is not on PATH (SDD_AGENT=claude). See $SETUP_GUIDE for setup." >&2 ;;
    copilot) echo "No agent CLI found: 'copilot' is not on PATH (SDD_AGENT=copilot). See $SETUP_GUIDE for setup." >&2 ;;
    *)       echo "No agent CLI found: neither 'claude' nor 'copilot' is on PATH (SDD_AGENT=auto). See $SETUP_GUIDE for setup." >&2 ;;
  esac
  print_manual_protocol
}

# Shared "no working agent backend" fallback, printed on the error path (before
# a non-zero exit) by every agent-backed command — align, implement, verify,
# fix-ktlint alike (D6). Previously this text was align-only and printed on a
# success path (exit 0); it is now unified across all four commands and always
# precedes a `return 1` / `exit 1`.
print_manual_protocol() {
  cat <<EOF >&2

Manual fallback protocol (do it by hand instead of dispatching an agent):
  1. Read CLAUDE.md and the target spec yourself.
  2. Write the alignment questions into the spec's '## Open Decisions (Alignment)' section:
       N. **Question:** <question>
       - **Answer:**
  3. Fill each '- **Answer:**' line by asking the user (don't answer yourself).
  4. Once answers are filled: ./scripts/sdd align-resolve <spec>  (sets alignment: resolved)
  5. Review the spec against CLAUDE.md by hand, then: ./scripts/sdd verify <spec>
  6. Implement tasks by hand, following CLAUDE.md; fix ktlint violations by hand too.
  See README.md for CLI setup (claude or copilot).
EOF
}

# Single seam every agent-backed command dispatches through. Resolves the
# backend (see resolve_agent_backend), resolves the role's model on that
# backend (see model_for_role), and routes to the backend's driver.
#
# Usage: run_agent <agent> <mode> <role> <prompt>
#   <mode>: edit      → --permission-mode acceptEdits
#             (with RUN_AGENT_CAPTURE=1 set by the caller, also tees output
#              into $RUN_AGENT_OUTPUT — used for sdd-refine's report)
#           full      → --permission-mode bypassPermissions
#           readonly  → --permission-mode dontAsk --allowedTools "Task,Read,Grep,Glob"
#             (also tees combined stdout/stderr into $RUN_AGENT_OUTPUT for
#              verdict parsing by the caller, e.g. cmd_verify)
#   <role>: align | implement | verify | ktlint — looked up in model_for_role,
#           NOT a literal model name (see §3's model-mapping table).
run_agent() {
  local agent="$1" mode="$2" role="$3" prompt="$4"
  local backend model
  backend="$(resolve_agent_backend)" || return 1
  model="$(model_for_role "$role" "$backend")" || return 1
  warn_user_deny_stale "$backend"
  case "$backend" in
    claude)
      driver_claude_run_agent "$agent" "$mode" "$model" "$prompt"
      ;;
    copilot)
      driver_copilot_run_agent "$agent" "$mode" "$model" "$prompt"
      ;;
    *)
      echo "run_agent: unsupported backend '$backend'" >&2
      return 1
      ;;
  esac
}

# Implements a single task with the sdd-implement agent + prints a commit hint.
run_task() { # <spec> <task>
  local spec="$1" task="$2" code id
  echo "→ Implementing $task (following CLAUDE.md rules) ..."
  # CLAUDE.md is auto-loaded via CLAUDE.md → @CLAUDE.md; the subagent definition
  # lives in .claude/agents/sdd-implement.md and is invoked by naming it in the
  # prompt. Claude Code's Task tool dispatches to the subagent, which runs in its
  # own context with its own tools (as declared in the agent's frontmatter).
  # Headless (`-p`) + bypassPermissions keeps the run non-interactive; no TUI.
  run_agent "sdd-implement" "full" "implement" \
    "Use the sdd-implement subagent to implement task $task from spec: $spec"
  code="$(type_code "$(fm_get "$spec" type)")"
  id="$(fm_get "$spec" task_id)"
  echo "Review changes → ./gradlew checkCodeQuality → commit:"
  echo "  git commit -m '[${code}-${id}] ${task} – <short-description>' -m 'Spec: ${spec#$ROOT/}'"
}

###############################################################################
# Agent sync: .claude/agents/*.md → .github/agents/*.agent.md (T7, spec 002)
###############################################################################
# `.claude/agents/*.md` stays the single source (P3); `sdd sync-agents` derives
# the Copilot CLI counterparts from it. `model:` is dropped so the driver's
# --model stays authoritative for both backends (D2); `color:` is dropped too —
# Copilot's agent schema has no such field.

AGENTS_SRC_DIR="$ROOT/.claude/agents"
AGENTS_DST_DIR="$ROOT/.github/agents"

# Reads a frontmatter field, scoped to the first '---'...'---' block only
# (unlike fm_get, which is not frontmatter-scoped and could match a body line).
agent_fm_get() { # <file> <key>
  awk -v k="$2" '
    NR==1 && /^---[[:space:]]*$/ { infm=1; next }
    infm && /^---[[:space:]]*$/ { exit }
    infm && $0 ~ "^" k ":" {
      sub("^" k ":[[:space:]]*", "")
      print
      exit
    }
  ' "$1"
}

# Everything after the closing '---' of the frontmatter block, verbatim.
agent_body() { # <file>
  awk '
    NR==1 && /^---[[:space:]]*$/ { infm=1; next }
    infm && /^---[[:space:]]*$/ { infm=0; started=1; next }
    started { print }
  ' "$1"
}

# Translates a comma-separated Claude `tools:` list into Copilot's tool names
# (§3 mapping table), de-duplicating (Grep and Glob both map to "search").
translate_tools() { # <claude-tools-csv>
  local input="$1" tool trimmed mapped out="" seen=","
  IFS=',' read -ra _tools_arr <<< "$input"
  for tool in "${_tools_arr[@]}"; do
    trimmed="$(echo "$tool" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
    [ -n "$trimmed" ] || continue
    case "$trimmed" in
      Read)  mapped="read" ;;
      Grep)  mapped="search" ;;
      Glob)  mapped="search" ;;
      Edit)  mapped="edit" ;;
      Write) mapped="write" ;;
      Bash)  mapped="shell" ;;
      *)
        echo "sdd sync-agents: unknown Claude tool '$trimmed' — no Copilot mapping known" >&2
        return 1
        ;;
    esac
    case "$seen" in
      *",$mapped,"*) ;;  # already present, skip
      *) seen="${seen}${mapped}," ; out="${out:+$out, }$mapped" ;;
    esac
  done
  echo "$out"
}

# Generates one .github/agents/<name>.agent.md from one .claude/agents/*.md.
sync_one_agent() { # <src-file> <dst-dir>
  local src="$1" dst_dir="$2" name description tools_raw tools dst

  name="$(agent_fm_get "$src" name)"
  description="$(agent_fm_get "$src" description)"
  tools_raw="$(agent_fm_get "$src" tools)"

  [ -n "$name" ] || { echo "sdd sync-agents: $src has no 'name:' in frontmatter" >&2; return 1; }
  # Copilot's schema requires 'description' (§3).
  [ -n "$description" ] || { echo "sdd sync-agents: $src has no 'description:' in frontmatter" >&2; return 1; }

  tools=""
  if [ -n "$tools_raw" ]; then
    tools="$(translate_tools "$tools_raw")" || return 1
  fi

  dst="$dst_dir/$name.agent.md"
  {
    echo "---"
    echo "name: $name"
    echo "description: $description"
    [ -n "$tools" ] && echo "tools: $tools"
    # model: intentionally omitted (D2) — the driver's --model stays
    # authoritative; color: intentionally omitted — no such field in Copilot's
    # agent schema.
    echo "---"
    echo "<!-- GENERATED — do not edit by hand. Source: .claude/agents/$(basename "$src"). Regenerate with: ./scripts/sdd sync-agents -->"
    agent_body "$src"
  } > "$dst"
  echo "  · $(basename "$src") → ${dst#$ROOT/}"
}

cmd_sync_agents() {
  [ -d "$AGENTS_SRC_DIR" ] || { echo "No $AGENTS_SRC_DIR directory found."; exit 1; }
  mkdir -p "$AGENTS_DST_DIR"
  local f had_files=0
  echo "→ Syncing .claude/agents/ → .github/agents/ ..."
  for f in "$AGENTS_SRC_DIR"/*.md; do
    [ -f "$f" ] || continue
    had_files=1
    sync_one_agent "$f" "$AGENTS_DST_DIR" || exit 1
  done
  [ "$had_files" -eq 1 ] || { echo "No agent files found in $AGENTS_SRC_DIR"; exit 1; }
  echo "✓ .github/agents/ regenerated."
}

###############################################################################
# User-level deny list: one list per user, outside every repository
###############################################################################
# The files and commands no agent may touch are kept by the user, not by the
# project: $SDD_DENY_LIST (default ~/.config/sdd/deny-list.txt). `sdd
# setup-user` turns that one list into each backend's own user-level
# configuration, which then holds in every project and every session:
#
#   Claude Code  permissions.deny in ${CLAUDE_CONFIG_DIR:-~/.claude}/settings.json,
#                and in Xcode's Claude Agent settings.json when Xcode's
#                directory exists (Xcode sets its own CLAUDE_CONFIG_DIR).
#   Copilot CLI  a preToolUse hook in ${COPILOT_HOME:-~/.copilot}/hooks/ that
#                reads the list on every tool call (Copilot's --deny-tool has no
#                read(path) rule kind; see `copilot help permissions`). The
#                list's shell commands also go to each run as --deny-tool flags
#                (driver-copilot.sh).
#
# Only the rules setup-user wrote are ever replaced: the ones it wrote last
# time are remembered per settings file under $SDD_USER_STATE_DIR, so rules
# the user added by hand stay where they are.

SDD_DENY_LIST="${SDD_DENY_LIST:-$HOME/.config/sdd/deny-list.txt}"
SDD_USER_STATE_DIR="$HOME/.config/sdd/state"
SDD_DENY_LIST_DEFAULT="$ROOT/scripts/lib/deny-list.default.txt"
CLAUDE_USER_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
SDD_XCODE_CLAUDE_DIR="${SDD_XCODE_CLAUDE_DIR:-$HOME/Library/Developer/Xcode/CodingAssistant/ClaudeAgentConfig}"
COPILOT_USER_DIR="${COPILOT_HOME:-$HOME/.copilot}"
COPILOT_HOOK_SRC="$ROOT/scripts/lib/copilot-deny-hook.sh"
COPILOT_HOOK_SCRIPT="$COPILOT_USER_DIR/hooks/sdd-deny.sh"
COPILOT_HOOK_CONFIG="$COPILOT_USER_DIR/hooks/sdd-deny.json"

# The list's entries, one per line: comments and blank lines dropped, ends trimmed.
deny_entries() {
  [ -f "$SDD_DENY_LIST" ] || return 0
  sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//' "$SDD_DENY_LIST" | grep -v -e '^$' -e '^#' || true
}

# One list entry → one Claude Code permission rule. A bare name follows
# gitignore rules and matches at any depth under the working directory, so
# the same rule covers every project from user settings. (A leading '/' would
# anchor it at ~/.claude instead.)
deny_entry_to_claude() { # <entry>
  case "$1" in
    *" "*) printf 'Bash(%s *)' "$1" ;;   # several words → a shell command
    *)     printf 'Read(%s)' "$1" ;;     # a file name or glob; also blocks Edit/Write there
  esac
}

# Where setup-user remembers the rules it wrote into <settings-file>.
claude_state_file() { # <settings-file>
  printf '%s/claude-%s.json' "$SDD_USER_STATE_DIR" "$(printf '%s' "$1" | cksum | awk '{print $1}')"
}

# Merges the list's rules into permissions.deny of <settings-file>: drops the
# rules setup-user wrote last time, appends the current ones, and leaves every
# other key and rule as it was. Writes through the file (not a rename), so a
# settings.json that is a symlink into a dotfiles repository stays one.
claude_apply_settings() { # <settings-file>
  local file="$1" state new old tmp
  state="$(claude_state_file "$file")"
  new="$(deny_entries | while IFS= read -r e; do deny_entry_to_claude "$e"; echo; done \
         | jq -Rsc 'split("\n") | map(select(length > 0))')"
  old="[]"
  [ -f "$state" ] && old="$(cat "$state")"
  mkdir -p "$(dirname "$file")" "$SDD_USER_STATE_DIR"
  if [ -s "$file" ]; then
    jq -e 'type == "object"' "$file" >/dev/null 2>&1 \
      || { echo "✗ $file is not a JSON object; fix it, then re-run ./scripts/sdd setup-user." >&2; return 1; }
    cp -p "$file" "$file.sdd-backup"
  else
    printf '{}\n' > "$file"
  fi
  tmp="$(mktemp)"
  if ! jq --argjson old "$old" --argjson new "$new" '
        .permissions = (.permissions // {})
        | .permissions.deny = (((.permissions.deny // []) - $old) as $keep | $keep + ($new - $keep))
      ' "$file" > "$tmp"; then
    rm -f "$tmp"
    echo "✗ Could not update $file." >&2
    return 1
  fi
  cat "$tmp" > "$file"
  rm -f "$tmp"
  printf '%s\n' "$new" > "$state"
  echo "✓ Claude Code: $file — $(printf '%s' "$new" | jq length) deny rule(s) from the list"
}

# Installs the Copilot hook: the script itself, and the hook definition that
# runs it with the list's path in its environment.
copilot_apply_hook() {
  mkdir -p "$(dirname "$COPILOT_HOOK_SCRIPT")"
  cat "$COPILOT_HOOK_SRC" > "$COPILOT_HOOK_SCRIPT"
  chmod +x "$COPILOT_HOOK_SCRIPT"
  jq -n --arg cmd "bash $(printf '%q' "$COPILOT_HOOK_SCRIPT")" --arg list "$SDD_DENY_LIST" '{
      version: 1,
      hooks: { preToolUse: [ {
        type: "command", bash: $cmd, env: { SDD_DENY_LIST: $list }, timeoutSec: 10
      } ] }
    }' > "$COPILOT_HOOK_CONFIG"
  echo "✓ Copilot CLI: $COPILOT_HOOK_CONFIG — preToolUse hook, reads the list on every tool call"
}

# Called before any agent runs (from resolve_agent_backend): refuses to start
# a backend the user's deny list has not been applied to.
require_user_deny() { # <backend>
  if [ ! -f "$SDD_DENY_LIST" ]; then
    echo "✗ No deny list at $SDD_DENY_LIST. Required once on this machine: ./scripts/sdd setup-user (it creates the list with default entries; fill it in, then run it again)" >&2
    return 1
  fi
  case "$1" in
    claude)
      [ -f "$(claude_state_file "$CLAUDE_USER_DIR/settings.json")" ] && return 0
      echo "✗ Your deny list is not applied to Claude Code yet ($CLAUDE_USER_DIR/settings.json). Run: ./scripts/sdd setup-user" >&2
      ;;
    copilot)
      [ -f "$COPILOT_HOOK_CONFIG" ] && [ -f "$COPILOT_HOOK_SCRIPT" ] && return 0
      echo "✗ The SDD deny hook is not installed for Copilot CLI ($COPILOT_HOOK_CONFIG). Run: ./scripts/sdd setup-user" >&2
      ;;
  esac
  return 1
}

# Called from run_agent, once per command: warns when the applied rules lag
# behind the list (Claude Code) or the kit's hook (Copilot CLI).
USER_DENY_WARNED=0
warn_user_deny_stale() { # <backend>
  [ "$USER_DENY_WARNED" -eq 0 ] || return 0
  USER_DENY_WARNED=1
  case "$1" in
    claude)
      if [ "$SDD_DENY_LIST" -nt "$(claude_state_file "$CLAUDE_USER_DIR/settings.json")" ]; then
        echo "⚠ $SDD_DENY_LIST changed after the last 'sdd setup-user'; Claude Code still has the old rules. Run: ./scripts/sdd setup-user" >&2
      fi
      ;;
    copilot)
      if ! cmp -s "$COPILOT_HOOK_SRC" "$COPILOT_HOOK_SCRIPT"; then
        echo "⚠ $COPILOT_HOOK_SCRIPT differs from this kit's hook; update it with: ./scripts/sdd setup-user" >&2
      fi
      ;;
  esac
}

# setup-user: creates the user's list if there is none, then applies it to
# Claude Code (and Xcode's Claude Agent) and Copilot CLI. Safe to re-run.
cmd_setup_user() {
  command -v jq >/dev/null 2>&1 \
    || { echo "✗ sdd setup-user needs jq (macOS 15 and later ship it; otherwise: brew install jq / apt install jq)." >&2; exit 1; }

  # The list always starts from the kit's defaults; the user then fills it in.
  # A project's scripts/lib/deny-list.txt from SDD 0.3 or earlier is never read.
  local created=0
  if [ ! -f "$SDD_DENY_LIST" ]; then
    mkdir -p "$(dirname "$SDD_DENY_LIST")"
    cp "$SDD_DENY_LIST_DEFAULT" "$SDD_DENY_LIST"
    created=1
    echo "→ Created $SDD_DENY_LIST with the default entries."
  fi
  local n
  n="$(deny_entries | wc -l | tr -d '[:space:]')"
  [ "$n" -gt 0 ] || { echo "✗ $SDD_DENY_LIST has no entries." >&2; exit 1; }
  echo "→ Applying $n entr$( [ "$n" -eq 1 ] && echo y || echo ies) from $SDD_DENY_LIST"

  claude_apply_settings "$CLAUDE_USER_DIR/settings.json" || exit 1
  if [ -d "$SDD_XCODE_CLAUDE_DIR" ] && [ "$SDD_XCODE_CLAUDE_DIR" != "$CLAUDE_USER_DIR" ]; then
    claude_apply_settings "$SDD_XCODE_CLAUDE_DIR/settings.json" || exit 1
  fi
  copilot_apply_hook || exit 1

  if [ -f "$ROOT/scripts/lib/deny-list.txt" ]; then
    echo
    echo "⚠ scripts/lib/deny-list.txt is left from SDD 0.3 or earlier and is not used; delete it."
  fi
  echo
  if [ "$created" -eq 1 ]; then
    echo "Now fill in $SDD_DENY_LIST: it holds only the defaults. Under \"# Your entries\","
    echo "add every file and command of your projects that no agent may touch, one per line,"
    echo "then run ./scripts/sdd setup-user again."
  else
    echo "Edit $SDD_DENY_LIST any time. Copilot CLI reads it on every tool call; for Claude Code, re-run ./scripts/sdd setup-user."
  fi
}

###############################################################################
# Commands
###############################################################################

cmd_new() {
  local type="$1"; shift
  local title="$*"
  local folder; folder="$(plural "$type")"
  [ -n "$folder" ] || { echo "Invalid type: $type (feature|bug|test|refactor)"; exit 1; }
  local tpl="$TEMPLATES/$type.md"
  [ -f "$tpl" ] || { echo "Template not found: $tpl"; exit 1; }

  local id name dir spec default_id input_id
  default_id="$(next_id)"
  # Ask the user for the task_id (e.g. a Jira ID); Enter accepts the suggested default.
  printf "task_id [%s]: " "$default_id" >&2
  read -r input_id || true

  input_id="$(echo "${input_id:-$default_id}" | sed -E 's/[[:space:]]+//g')"
  id="$(slugify "$input_id")"
  [ -n "$id" ] || id="$default_id"
  name="$(slugify "$title")"
  dir="$SPECS/$folder/$id-$name"
  spec="$dir/spec.md"
  mkdir -p "$dir"
  cp "$tpl" "$spec"

  fm_set "$spec" task_id "$id"
  fm_set "$spec" task_name "$name"
  fm_set "$spec" status "draft"
  fm_set "$spec" created "$(today)"
  fm_set "$spec" updated "$(today)"
  # Also insert the title
  sed_inplace "$spec" -E "s|\{Title\}|$title|"

  local rel="${spec#$ROOT/}"
  echo "✓ Spec created: $rel  (status: draft)"
  echo "  Next: fill it in → sdd ready → sdd align → sdd verify → sdd start"
  echo "  ready:  ./scripts/sdd ready $rel"
}

cmd_align() {
  local spec="$1"
  [ -f "$spec" ] || { echo "Spec not found: $spec"; exit 1; }

  # Resolve the backend BEFORE touching the spec (D6): a no-op run (no CLI
  # available) must leave the file byte-identical, not reset alignment/verify
  # to 'pending' and then bail. On failure, resolve_agent_backend has already
  # printed the reason + the shared manual-protocol fallback; just exit.
  local backend
  backend="$(resolve_agent_backend)" || exit 1

  # Add skeleton if Open Decisions (Alignment) section is missing
  if ! grep -qiE "^#{1,6}.*Open Decisions \(Alignment\)" "$spec"; then
    printf '\n## Open Decisions (Alignment)\n--- Agent fills this in; each item: bold Question line + bold Answer line below it ---\n' >> "$spec"
  fi
  # Alignment gate: 'start' is blocked until answered.
  fm_upsert "$spec" alignment "pending"
  # Re-aligning changes the spec → any prior verify pass is stale, force a re-verify.
  fm_upsert "$spec" verify "pending"
  # Same reasoning for the critique loop: new questions mean the reviewed
  # artifact no longer exists, so a prior convergence no longer describes it.
  fm_upsert "$spec" critique "pending"
  fm_set "$spec" updated "$(today)"

  echo "→ Alignment ($backend): questions will be generated and written into the spec ..."
  # Subagent definition is in .claude/agents/sdd-align.md; invoked by name in the
  # prompt so Claude Code dispatches to it via its Task tool. Headless (`-p`)
  # keeps the run non-interactive: the subagent writes questions into the spec
  # and exits — no TUI, no chat.
  run_agent "sdd-align" "edit" "align" \
    "Use the sdd-align subagent for spec: $spec"
  echo
  echo "✓ Alignment questions written. Status:"
  grep -E '^alignment:' "$spec" || true
  echo "  Next: open the spec, fill each '- **Answer:**' line, then:"
  echo "    ./scripts/sdd align-resolve $spec"
  echo "    ./scripts/sdd critique $spec"
  echo "    ./scripts/sdd verify $spec"
}

cmd_align_resolve() {
  local spec="$1"
  [ -f "$spec" ] || { echo "Spec not found: $spec"; exit 1; }
  grep -qiE "^#{1,6}.*Open Decisions \(Alignment\)" "$spec" || {
    echo "✗ Spec has no '## Open Decisions (Alignment)' section. Run 'sdd align' first."; exit 1; }

  local out quest answ empty miss
  out="$(check_alignment "$spec")"
  quest="$(printf '%s' "$out" | sed -n 's/.*QUEST=\([0-9]*\).*/\1/p')"
  answ="$(printf '%s' "$out" | sed -n 's/.*ANSW=\([0-9]*\).*/\1/p')"
  empty="$(printf '%s' "$out" | sed -n 's/.*EMPTY=\([0-9]*\).*/\1/p')"
  miss="$(printf '%s\n' "$out" | sed -n 's/^MISS=//p')"

  if [ "${quest:-0}" -eq 0 ]; then
    echo "✗ No '**Question:**' entries in Alignment section. Run 'sdd align' to add them."; exit 1
  fi
  if [ "${answ:-0}" -lt "${quest:-0}" ] || [ "${empty:-0}" -gt 0 ]; then
    echo "✗ Not all questions answered (quest=$quest, answered=$(( answ - empty ))/$quest)."
    [ -n "$miss" ] && echo "  Missing answers: $miss"
    echo "  Fill each '- **Answer:**' line under every '**Question:**', then try again."
    exit 1
  fi
  fm_set "$spec" alignment "resolved"
  fm_set "$spec" updated "$(today)"
  echo "✓ All alignment questions answered → alignment: resolved ($quest/$quest)."
  echo "  Next: sdd critique $spec   (then: sdd verify $spec)"
}

# draft → ready gate: are the required sections (SDD-README.md, "3. Mark it ready") filled?
cmd_ready() {
  local spec="$1"
  [ -f "$spec" ] || { echo "Spec not found: $spec"; exit 1; }
  local status
  status="$(fm_get "$spec" status)"
  case "$status" in
    draft) ;;
    ready|active) echo "Already $status."; exit 0 ;;
    *) echo "ready only works from draft (current: $status)."; exit 1 ;;
  esac

  # TODO: add required-section checks here via section_filled() as per SDD-README.md ("3. Mark it ready")
  fm_set "$spec" status "ready"
  fm_set "$spec" updated "$(today)"
  echo "✓ status: ready"
  echo "  Next: sdd align $spec"
}

# ready → active: create feature branch
cmd_start() {
  local spec="$1"
  [ -f "$spec" ] || { echo "Spec not found: $spec"; exit 1; }
  local status
  status="$(fm_get "$spec" status)"
  [ "$status" = "ready" ] || { echo "start only works from ready (current: $status). Run 'sdd ready' first."; exit 1; }

  require_alignment_resolved "$spec" || exit 1
  require_critique_converged "$spec" || exit 1
  require_verify_passed "$spec" || exit 1

  local id name branch prefix="${SDD_BRANCH_PREFIX%/}"
  case "$prefix" in
    ""|*[[:space:]]*) echo "✗ SDD_BRANCH_PREFIX must be a non-empty word without spaces (got '$SDD_BRANCH_PREFIX')."; exit 1 ;;
  esac
  id="$(fm_get "$spec" task_id)"
  name="$(fm_get "$spec" task_name)"
  branch="$prefix/$id-$name"
  # A branch named exactly like the prefix blocks every '<prefix>/...' branch.
  # Catch it before git does, with a fix the user can act on.
  if git -C "$ROOT" show-ref --verify --quiet "refs/heads/$prefix"; then
    echo "✗ Cannot create '$branch': a branch named '$prefix' already exists, and git"
    echo "  cannot have both '$prefix' and '$prefix/...'. Pick another prefix, e.g.:"
    echo "    SDD_BRANCH_PREFIX=feature ./scripts/sdd start $spec"
    exit 1
  fi
  echo "→ Creating branch: $branch"
  git -C "$ROOT" checkout -b "$branch"

  fm_set "$spec" status "active"
  fm_set "$spec" branch "$branch"
  fm_set "$spec" updated "$(today)"
  echo "✓ status: active, branch: $branch written."
}

cmd_implement() {
  local spec="$1" task="${2:-}"
  [ -f "$spec" ] || { echo "Spec not found: $spec"; exit 1; }
  local status branch cur
  status="$(fm_get "$spec" status)"
  branch="$(fm_get "$spec" branch)"
  [ "$status" = "active" ] || { echo "Spec is not active ($status). Run 'sdd start' first."; exit 1; }
  cur="$(git -C "$ROOT" rev-parse --abbrev-ref HEAD)"
  [ "$cur" = "$branch" ] || { echo "Wrong branch ($cur). Expected: $branch"; exit 1; }

  require_alignment_resolved "$spec" || exit 1
  require_critique_converged "$spec" || exit 1
  require_verify_passed "$spec" || exit 1
  resolve_agent_backend >/dev/null || exit 1

  if [ -n "$task" ]; then
    run_task "$spec" "$task"
    return
  fi

  # No task given → implement every task that is not ticked yet, in order,
  # one agent session per task. Ticked tasks ('- [x] T1') are already done.
  local tasks open t
  tasks="$(list_tasks "$spec")"
  [ -n "$tasks" ] || { echo "No tasks found in spec (## Task List). Usage: sdd implement <spec.md> [Task]"; exit 1; }
  open="$(list_open_tasks "$spec")"
  if [ -z "$open" ]; then
    echo "✓ Every task in ## Task List is already ticked — nothing to implement."
    echo "  To redo one: ./scripts/sdd implement $spec <Task>"
    return 0
  fi
  echo "→ No task specified; open tasks will be implemented in order: $(echo "$open" | tr '\n' ' ')"
  # A word loop, not 'while read … <<< $open': nothing here reads stdin, so an
  # agent can never swallow the rest of the list (task ids contain no spaces).
  for t in $open; do
    echo "════════════════════════════════════════"
    run_task "$spec" "$t"
  done
  echo "════════════════════════════════════════"
  local left
  left="$(list_open_tasks "$spec")"
  if [ -n "$left" ]; then
    echo "⚠ Still unticked after this run: $(echo "$left" | tr '\n' ' ')— read the agent reports above."
  else
    echo "✓ All tasks are ticked."
  fi
}

# The one prompt both verify call sites send (standalone 'sdd verify' and the
# in-loop arbiter in scripts/lib/critique.sh), so the scope rule cannot drift
# between them. The scope paragraph repeats .claude/agents/sdd-verify.md on
# purpose: the wrapper session relays the subagent, and a verify run that
# reported the script's own bookkeeping (front matter saying 'critique:
# pending' while the Critique Log already says CONVERGED) could never pass
# inside the loop.
#   <context>: standalone | loop
verify_prompt() { # <spec> <context>
  local spec="$1" context="${2:-standalone}" context_block=""
  if [ "$context" = "loop" ]; then
    context_block="
You are running INSIDE 'sdd critique' as this round's final arbiter. The front matter reads
'critique: pending' and 'verify: pending' by design until the loop has your verdict, and the
Critique Log may already show this round as CONVERGED. That is expected, not a mismatch."
  fi
  cat <<EOF
Use the sdd-verify subagent for spec: $spec
Judge the spec's CONTENT against CLAUDE.md only. The lifecycle state written by scripts/sdd —
the front-matter fields status, branch, alignment, verify, critique, critique_score,
critique_rounds, created, updated, blocked_reason, dropped_reason, and the '## Critique Log'
table — is out of scope: its values, and whether they agree with each other, are never a FAIL
item or a '## Suspicious' item.$context_block

Then relay the subagent's verdict line verbatim as YOUR first line of output: either
'VERIFY: PASS' or 'VERIFY: FAIL', with nothing before it — not a preamble, not a heading.
Put your summary after that line. This line is parsed by a script; omitting it fails the run.
EOF
}

cmd_verify() {
  local spec="$1"
  [ -f "$spec" ] || { echo "Spec not found: $spec"; exit 1; }
  local backend
  backend="$(resolve_agent_backend)" || exit 1
  echo "→ Checking spec for contradictions with CLAUDE.md ..."
  # CLAUDE.md is auto-loaded via CLAUDE.md → @CLAUDE.md; the audit protocol lives
  # in .claude/agents/sdd-verify.md and is invoked as a subagent (frontmatter
  # tools: Read/Grep/Glob → truly read-only). --permission-mode dontAsk denies
  # anything outside the whitelist without prompting, so the run stays headless.
  # We parse the machine-readable verdict from the subagent's output. `claude -p` returns
  # the WRAPPER session's reply, not the subagent's raw output, and the wrapper tends to
  # summarise — dropping the verdict line and leaving us "inconclusive" on a genuine PASS.
  # So the prompt explicitly requires the verdict to be relayed verbatim as the first line.
  # Guarded explicitly (not a bare statement): a non-zero return here means the
  # CLI itself failed before producing usable output (rejected flag, crashed,
  # etc.) — an infrastructure failure, distinct from a completed run with no
  # parseable verdict (D5). That case must leave the front matter untouched and
  # exit non-zero, so it must not fall through to the fm_upsert below, and it
  # must not trip `set -e`'s uncontrolled exit before we can report/clean up.
  if ! run_agent "sdd-verify" "readonly" "verify" "$(verify_prompt "$spec" standalone)"; then
    rm -f "${RUN_AGENT_OUTPUT:-}"
    echo
    echo "✗ Verify could not run — the agent CLI failed before producing any output" \
      "(rejected flag, crashed, missing auth, etc.). Front matter left untouched;" \
      "fix the CLI/flags and re-run 'sdd verify'." >&2
    exit 1
  fi
  local tmp="$RUN_AGENT_OUTPUT"

  local verdict=""
  if grep -qE 'VERIFY:[[:space:]]*PASS' "$tmp"; then
    verdict="passed"
  elif grep -qE 'VERIFY:[[:space:]]*FAIL' "$tmp"; then
    verdict="failed"
  fi

  # Keep the report next to the spec. The terminal scroll-back used to be the
  # only record of WHY verify failed; the critique loop's in-loop gate already
  # writes critique/round-N-verify.md, this is its standalone counterpart.
  local verify_dir report
  verify_dir="$(cd "$(dirname "$spec")" && pwd)/verify"
  mkdir -p "$verify_dir"
  report="$verify_dir/verify-$(date +%Y%m%d-%H%M%S).md"
  {
    echo "<!-- generated by ./scripts/sdd verify — $(today) -->"
    echo "<!-- verify model: $(model_for_role verify "$backend") | verdict: ${verdict:-none} -->"
    echo
    cat "$tmp"
  } > "$report"
  rm -f "$tmp"

  echo
  echo "  report → ${report#$ROOT/}"
  if [ "$verdict" = "passed" ]; then
    fm_upsert "$spec" verify "passed"
    fm_set "$spec" updated "$(today)"
    echo "✓ Verify PASSED — no open questions/contradictions (verify: passed)."
    echo "  Next: sdd implement $spec"
    return 0
  fi

  # FAIL or no verdict detected → both block implement.
  fm_upsert "$spec" verify "failed"
  fm_set "$spec" updated "$(today)"
  if [ "$verdict" = "failed" ]; then
    echo "✗ Verify FAILED — resolve the items above in the spec, then run 'sdd verify' again."
  else
    echo "✗ Verify inconclusive (no VERIFY verdict detected) — treated as FAIL. Re-run 'sdd verify'."
  fi
  echo "  'sdd implement' is blocked until verify passes."
  exit 1
}

cmd_done() {
  local spec="$1"
  [ -f "$spec" ] || { echo "Spec not found: $spec"; exit 1; }
  local status
  status="$(fm_get "$spec" status)"
  [ "$status" = "active" ] || { echo "done only works after active (current: $status). Run 'sdd start' first."; exit 1; }
  echo "→ Running quality gates ..."
  ( cd "$ROOT" && ./gradlew checkCodeQuality assembleDevDebug )
  fm_set "$spec" status "done"
  fm_set "$spec" updated "$(today)"
  echo "✓ status: done. Don't forget to merge the branch."
}

# Delegates ktlint violations that ktlintFormat cannot fix to the kotlin-ktlint agent.
# Usage: sdd fix-ktlint [gradle-task]   (default task: app:ktlint)
cmd_fix_ktlint() {
  local gradle_task="${1:-app:ktlint}"
  resolve_agent_backend >/dev/null || exit 1

  local tmp rc=0; tmp="$(mktemp)"
  echo "→ Running ktlint (./gradlew $gradle_task) ..."
  # Gradle returns non-zero if there are violations; collect output anyway and
  # keep the exit code, so a run that failed for another reason is not "clean".
  ( cd "$ROOT" && ./gradlew "$gradle_task" < /dev/null ) >"$tmp" 2>&1 || rc=$?

  # Extract .kt files with violations: 'path.kt:line:col' → path (relative to ROOT, deduplicated).
  local files
  files="$( { grep -oE '[^[:space:]]+\.kt:[0-9]+:[0-9]+' "$tmp" || true; } \
    | sed -E 's/:[0-9]+:[0-9]+$//' \
    | sed "s|^$ROOT/||" \
    | sort -u | paste -sd, - )"

  if [ -z "$files" ]; then
    if [ "$rc" -ne 0 ]; then
      # Non-zero exit with no 'File.kt:line:col' in the output: ktlint never
      # reported anything — the task is missing, or the build/download failed.
      echo "✗ ./gradlew $gradle_task failed (exit $rc) without reporting any ktlint violation."
      echo "  The task may not exist in this project, or Gradle failed before ktlint ran."
      echo "  Last lines of the Gradle output:"
      tail -n 15 "$tmp" | sed 's/^/    /'
      echo "  Pass the project's ktlint task explicitly, e.g.: ./scripts/sdd fix-ktlint app:ktlintCheck"
      rm -f "$tmp"; exit 1
    fi
    echo "✓ No ktlint violations found, nothing to fix."
    rm -f "$tmp"; return 0
  fi

  echo "→ Sending files with violations to the kotlin-ktlint agent:"
  echo "$files" | tr ',' '\n' | sed 's/^/  · /'

  run_agent "kotlin-ktlint" "edit" "ktlint" \
    "Use the kotlin-ktlint subagent to fix the following violations.

## Files to modify
$files

## Current ktlint violations
$(cat "$tmp")"

  rm -f "$tmp"
  echo "→ Verify again: ./gradlew $gradle_task"
}

cmd_block() {
  local spec="$1"; shift; local reason="$*"
  fm_set "$spec" status "blocked"
  fm_set "$spec" blocked_reason "$reason"
  fm_set "$spec" updated "$(today)"
  echo "✓ status: blocked — $reason"
}

cmd_drop() {
  local spec="$1"; shift; local reason="$*"
  fm_set "$spec" status "dropped"
  fm_set "$spec" dropped_reason "$reason"
  fm_set "$spec" updated "$(today)"
  echo "✓ status: dropped — $reason"
}

cmd_list() {
  local filter="${1:-}"
  printf "%-12s %-10s %-26s %s\n" "TYPE" "STATUS" "ID-NAME" "BRANCH"
  for d in "$SPECS"/{features,bugs,tests,refactors}/*/; do
    [ -d "$d" ] || continue
    local spec="$d/spec.md"; [ -f "$spec" ] || continue
    local type status branch base
    type="$(fm_get "$spec" type)"
    [ -n "$filter" ] && [ "$type" != "$filter" ] && continue
    status="$(fm_get "$spec" status)"
    branch="$(fm_get "$spec" branch)"
    base="$(basename "$d")"
    printf "%-12s %-10s %-26s %s\n" "$type" "$status" "$base" "$branch"
  done
}

###############################################################################
# Kit version and self-update
###############################################################################
# install.sh writes the installed kit version to scripts/lib/VERSION: X.Y.Z for
# a release, X.Y.Z-dev+<branch>.<commit> for a branch install. In the kit
# repository itself it is VERSION plus the checked-out commit.

SDD_REPO="${SDD_REPO:-ataahmet/SddApp}"

kit_version() {
  local base sha
  if [ -f "$ROOT/scripts/lib/VERSION" ]; then
    tr -d '[:space:]' < "$ROOT/scripts/lib/VERSION"
  elif [ -f "$ROOT/kit/manifest.txt" ] && [ -f "$ROOT/VERSION" ]; then
    # Same rule as scripts/sdd-release: plain VERSION only on its clean tag.
    base="$(tr -d '[:space:]' < "$ROOT/VERSION")"
    if [ "$(git -C "$ROOT" describe --exact-match --tags HEAD 2>/dev/null)" = "v$base" ] \
       && git -C "$ROOT" diff --quiet HEAD 2>/dev/null; then
      echo "$base"
      return
    fi
    sha="$(git -C "$ROOT" rev-parse --short=7 HEAD 2>/dev/null || echo unknown)"
    git -C "$ROOT" diff --quiet HEAD 2>/dev/null || sha="$sha.dirty"
    echo "$base-dev+$sha"
  else
    echo "unknown (installed before versioning; ./scripts/sdd self-update records it)"
  fi
}

cmd_version() {
  echo "sdd $(kit_version)"
}

# Fetches <url> into <file> with curl or wget.
download() { # <url> <file>
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --retry 2 -o "$2" "$1"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$2" "$1"
  else
    echo "✗ Neither curl nor wget is installed." >&2
    return 1
  fi
}

# Re-runs the remote installer on this project with --update: the kit's files
# are refreshed; CLAUDE.md, .claude/settings.json and .claude/agents/ are
# kept. The installer swaps each file in by rename, so replacing this running
# script is safe.
#
# The installer comes from the release being installed (an asset since 0.2.0),
# so a project only runs installer code that shipped with that kit; a branch
# uses the branch's copy. Releases older than that carry no installer, and
# main's copy stands in for them.
cmd_self_update() {
  local version="${1:-latest}" url fallback script rc=0
  if [ -f "$ROOT/kit/manifest.txt" ]; then
    echo "This is the SDD kit repository itself — update it with git pull."
    return 0
  fi
  case "$version" in
    latest)         url="https://github.com/$SDD_REPO/releases/latest/download/install.sh" ;;
    v[0-9]*|[0-9]*) url="https://github.com/$SDD_REPO/releases/download/v${version#v}/install.sh" ;;
    *)              url="https://raw.githubusercontent.com/$SDD_REPO/$version/install.sh" ;;
  esac
  url="${SDD_INSTALL_URL:-$url}"
  fallback="https://raw.githubusercontent.com/$SDD_REPO/main/install.sh"
  script="$(mktemp)"
  echo "→ Updating SDD in $ROOT ($(kit_version) → $version) ..."
  if ! download "$url" "$script" 2>/dev/null; then
    if [ "$url" = "$fallback" ] || ! download "$fallback" "$script"; then
      rm -f "$script"
      echo "✗ Could not download the installer: $url" >&2
      return 1
    fi
  fi
  bash "$script" --update --dir "$ROOT" --version "$version" || rc=$?
  rm -f "$script"
  return "$rc"
}

###############################################################################
# Usage / entry point
###############################################################################

usage() {
  cat <<'EOF'
sdd — Specification-Driven Development CLI

Usage:
  sdd new <feature|bug|test|refactor> "title"       Create a spec (status: draft)
  sdd align  <spec.md>                               Generate alignment questions (agent writes them into the spec)
  sdd align-resolve <spec.md>                        Check all '**Answer:**' lines are filled → alignment: resolved
  sdd critique <spec.md> [--rounds N] [--threshold N]  Critique-to-action loop: a reviewer model (SDD_MODEL_CRITIQUE) scores the spec, executor applies the action items, repeat until converged (default: max 4 rounds, >= 6/10, 0 critical, 0 major; stops early as needs_user on user-owned or stalled items)
  sdd ready  <spec.md>                               Required-sections gate → status: ready
  sdd start  <spec.md>                               Open branch (agent) → status: active (alignment: resolved required)
  sdd verify <spec.md>                               Mandatory gate: check spec vs CLAUDE.md → verify: passed/failed
  sdd implement <spec.md> [Task]                     Implement a task; omit Task to implement every open (unticked) task in order (active+branch, alignment: resolved required)
  sdd fix-ktlint [gradle-task]                       Fix ktlint violations with agent (default: app:ktlint)
  sdd sync-agents                                    Regenerate .github/agents/*.agent.md from .claude/agents/*.md
  sdd setup-user                                     REQUIRED once per machine: create your deny list (~/.config/sdd/deny-list.txt) with defaults and apply it to Claude Code and Copilot CLI; fill in the list, then run it again
  sdd done   <spec.md>                               Quality gates + status: done
  sdd block  <spec.md> "<reason>"                    status: blocked
  sdd drop   <spec.md> "<reason>"                    status: dropped
  sdd list   [feature|bug|test|refactor]             List specs
  sdd version                                        Installed kit version
  sdd self-update [X.Y.Z]                            Update this project's SDD files from GitHub (latest release by default); keeps CLAUDE.md, .claude/settings.json, .claude/agents/

Flow:      new → ready → align → align-resolve → critique → verify → start → implement → done
Lifecycle: draft → ready → active → done | blocked | dropped (SDD-README.md)
Branch:    <prefix>/{task_id}-{task_name} (e.g. sdd/001-biometric-login); prefix = SDD_BRANCH_PREFIX, default 'sdd'
EOF
}

main() {
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    new)            cmd_new "$@" ;;
    align)          cmd_align "$@" ;;
    align-resolve)  cmd_align_resolve "$@" ;;
    critique)       cmd_critique "$@" ;;
    ready)          cmd_ready "$@" ;;
    start)          cmd_start "$@" ;;
    implement)      cmd_implement "$@" ;;
    verify)         cmd_verify "$@" ;;
    fix-ktlint)     cmd_fix_ktlint "$@" ;;
    sync-agents)    cmd_sync_agents "$@" ;;
    setup-user)     cmd_setup_user "$@" ;;
    done)           cmd_done "$@" ;;
    block)          cmd_block "$@" ;;
    drop)           cmd_drop "$@" ;;
    list)           cmd_list "$@" ;;
    version|-v|--version) cmd_version ;;
    self-update)    cmd_self_update "$@" ;;
    ""|"-h"|"--help"|help) usage ;;
    *) echo "Unknown command: $cmd"; usage; exit 1 ;;
  esac
}

main "$@"